# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"

sketchybar --load-font "$CONFIG_DIR/fonts/sketchybar-app-font.ttf"
sketchybar --load-font "$HOME/Library/Fonts/SketchyBarStatus6.ttf"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

sketchybar --bar position=top height=40 topmost=window sticky=on blur_radius=30 color=0xd9161618

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=5
  padding_right=5
  icon.font="SF Pro Text:Semibold:15.0"
  label.font="SF Pro Text:Medium:13.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Adding AeroSpace Workspace Indicators #####
# Each monitor's bar shows only the occupied or visible workspaces on that
# monitor. aerospace.sh moves items between bars as workspaces move.
sketchybar --add event aerospace_workspace_refresh

source "$PLUGIN_DIR/space_item.sh"
for sid in $(/opt/homebrew/bin/aerospace list-workspaces --all); do
  space_item_props "$sid"
  sketchybar --add item space."$sid" left \
             --set space."$sid" "${SPACE_ITEM_PROPS[@]}"
done

sketchybar --add item aerospace_workspace_listener left \
           --set aerospace_workspace_listener drawing=off \
                 script="$PLUGIN_DIR/aerospace.sh" \
           --subscribe aerospace_workspace_listener \
                 aerospace_workspace_refresh front_app_switched space_windows_change \
                 display_change system_woke

##### Adding Left Items #####
# We add some regular items to the left side of the bar, where
# only the properties deviating from the current defaults need to be set

sketchybar --add item chevron left \
           --set chevron icon=􀆊 icon.font="SF Pro Text:Semibold:11.0" icon.color=0x99ebebf5 label.drawing=off \
           --add item front_app left \
           --set front_app icon.drawing=off label.font="SF Pro Text:Bold:13.0" script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# Brings an AeroSpace-"minimised" window back when its app is activated from
# the Dock or Raycast. See ~/.config/aerospace/minimize.sh.
sketchybar --add item minimize_watcher left \
           --set minimize_watcher drawing=off \
                 script='[ "$SENDER" = front_app_switched ] && "$HOME/.config/aerospace/minimize.sh" on-app-activated "$INFO"' \
           --subscribe minimize_watcher front_app_switched

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle while others respond to subscribed
# system events. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

sketchybar --add item clock right \
           --set clock update_freq=10 padding_left=5 padding_right=5 icon.drawing=off \
                    label.font="SF Pro Text:Medium:13.0" \
                   label.padding_left=2 label.padding_right=2 \
                   script="$PLUGIN_DIR/clock.sh" \
            --add item control_center right \
            --set control_center padding_left=5 padding_right=3 \
                   icon="" label.drawing=off \
                   icon.font="SketchyBar Status 6:Regular:15.0" \
                   icon.y_offset=-1 \
                   icon.padding_left=2 icon.padding_right=2 \
                   script="$PLUGIN_DIR/control_center.sh" \
            --subscribe control_center mouse.clicked \
            --add item battery right \
            --set battery update_freq=120 padding_left=4 padding_right=14 \
                    icon="" icon.width=25 icon.drawing=on \
                    icon.font="SketchyBar Status 6:Regular:29.0" \
                    icon.y_offset=-3 \
                    icon.padding_left=1 icon.padding_right=1 \
                    icon.background.drawing=off \
                    label.font="SF Pro Text:Medium:13.0" \
                  label.width=36 label.align=right \
                  label.padding_left=0 label.padding_right=2 \
                 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item status_separator right \
           --set status_separator icon="│" icon.color=0x33ffffff \
                  padding_left=0 padding_right=11 \
                  icon.font="SF Pro Text:Light:15.0" \
                  icon.padding_left=4 icon.padding_right=4 \
                  label.drawing=off \
           --add item meeting_event right \
           --set meeting_event icon.drawing=off \
                  label.font="SF Pro Text:Medium:13.0" \
                 label.padding_left=0 label.padding_right=4 \
                 click_script="/usr/bin/open -a Calendar" \
           --add item meeting right \
            --set meeting update_freq=30 icon=􀉉 icon.font="SF Pro Text:Regular:14.0" \
                  label.font="SF Pro Text:Semibold:13.0" \
                  label.padding_right=6 \
                 script="$PLUGIN_DIR/meeting.sh" \
                 click_script="/usr/bin/open -a Calendar" \
            --subscribe meeting system_woke \
           --add item granola right \
           --set granola update_freq=5 icon=":granola:" \
                  icon.font="sketchybar-app-font:Regular:16.0" \
                  icon.color=0x99ebebf5 \
                  label.font="SF Pro Text:Semibold:13.0" \
                  label.drawing=off \
                  script="$PLUGIN_DIR/granola.sh" \
           --subscribe granola mouse.clicked system_woke front_app_switched

# The island (island/Sources) grows out of the notch: the Spotify player, the
# inbox, and messages from `notch`. It sets the bell's colour and count itself.
pgrep -xq Island || nohup "$CONFIG_DIR/island/Island" >/dev/null 2>&1 &

# Bell: orange with a count while T3 threads wait on you, white when there are
# unseen messages, dim otherwise. Click for the inbox.
sketchybar --add item notch_inbox right \
           --set notch_inbox icon=󰂚 icon.color=0x33ffffff \
                  icon.font="Hack Nerd Font:Bold:16.0" \
                  label.drawing=off label.color=0xffffa94d \
                  label.font="SF Pro Text:Semibold:13.0" label.padding_left=0 \
                  click_script="$CONFIG_DIR/island/Island inbox"

# Spotify, shown only while playing. Spotify posts a distributed notification
# on every play/pause/track change, so no polling is needed. Right items render
# in reverse insertion order, so this reads: title, artist, divider, bell.
sketchybar --add event spotify_change com.spotify.client.PlaybackStateChanged \
           --add item spotify_separator right \
           --set spotify_separator drawing=off icon="│" icon.color=0x33ffffff \
                  icon.font="SF Pro Text:Light:15.0" label.drawing=off \
                  padding_left=6 padding_right=6 \
           --add item spotify_artist right \
           --set spotify_artist drawing=off icon.drawing=off \
                  label.color=0x99ebebf5 padding_left=0 label.padding_left=6 \
                  click_script="$CONFIG_DIR/island/Island spotify" \
           --add item spotify right \
           --set spotify drawing=off icon=":spotify:" \
                  icon.font="sketchybar-app-font:Regular:16.0" \
                  icon.color=0xff1db954 icon.padding_right=2 \
                  padding_right=0 label.padding_right=4 \
                  script="$PLUGIN_DIR/spotify.sh" \
                  click_script="$CONFIG_DIR/island/Island spotify" \
           --subscribe spotify spotify_change system_woke

# Right-positioned items render in reverse insertion order.
sketchybar --move control_center before clock

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
